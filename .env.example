WHYCODE_ENV=dev

# Neo4j (Aura or local Docker). No other application database is used.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# Auth. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
WHYCODE_JWT_SECRET=change-me
WHYCODE_TOKEN_TTL_MINUTES=720

# GitHub. Public repos work without a token at low volume; a read-only
# fine-grained token is recommended for the demo.
GITHUB_TOKEN=
GITHUB_API=https://api.github.com

# LLM. Leave the key empty to run in deterministic evidence mode.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
WHYCODE_LLM_MODE=auto

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
WHYCODE_INGEST_DIR=./data/repos
WHYCODE_MAX_FILES=140
WHYCODE_MAX_COMMITS=25
WHYCODE_MAX_PRS=8
WHYCODE_MAX_ISSUES=8
WHYCODE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex for Vercel preview deployments, e.g. https://.*\.vercel\.app
# WHYCODE_CORS_ORIGIN_REGEX=
